rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // The Admin (André, by email) keeps full access; everyone else — partners
    // included — goes by the permissions on their sign-in token (Partner is an
    // ordinary role since 30 Sep).
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'andre.rocha@douropartners.pt';
    }
    // Team access: permissions from the sign-in token's claims.
    function can(p) {
      return request.auth != null && p in request.auth.token.get('perms', []);
    }

    // Investors download via the tokenized downloadURL stored in Firestore,
    // which bypasses these rules by design — so scoping read to admins does
    // NOT affect investor downloads. It only closes direct, path-based access
    // to files an investor was never granted.
    match /documents/{fileName} {
      allow read: if isAdmin() || can('portal.admin');
      allow write: if isAdmin() || can('portal.admin');
    }

    // Budget attachments (receipts/invoices) — admin-only, like documents.
    match /budget/{fileName} {
      allow read: if isAdmin() || can('budget.view');
      allow write: if isAdmin() || can('budget.edit');
    }

    // Outreach reply attachments and oversized email bodies. Written only by
    // the resendWebhook Cloud Function (Admin SDK, bypasses rules); admins
    // read them from the Outreach tab. No client writes.
    match /outreach/{allPaths=**} {
      allow read: if isAdmin() || can('out.view');
      allow write: if false;
    }
  }
}
