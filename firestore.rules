rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The two founders (by email, as before).
    function isPartner() {
      return request.auth != null &&
             request.auth.token.email in [
               'andre.rocha@douropartners.pt',
               'antonio.carvalho@douropartners.pt'
             ];
    }
    // Admin / Partner split (30 Sep): the Admin (André) keeps full access to
    // everything. Partners keep full access except the Admin-only records,
    // which they can't change directly (the server functions still can).
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'andre.rocha@douropartners.pt';
    }
    function adminOnly(coll, docId) {
      return coll in ['team', 'roles', 'accessAudit', 'usageDaily', 'usageFirestore', 'usageMonthly', 'usageAlerts',
                      'outreachSettings', 'outreachSenders', 'outreachCompliance']
        || (coll == 'config' && docId in ['features', 'teamEmailHashes']);
    }
    match /{coll}/{docId} {
      allow read, create, update: if isOwner() || (isPartner() && !adminOnly(coll, docId));
      // Removing someone from the suppression list (they could be emailed again) is Admin-only.
      allow delete: if isOwner() || (isPartner() && !adminOnly(coll, docId) && coll != 'outreachSuppression');
    }
    // Sub-collections ({sub} makes sure this never matches a top-level record: {rest=**} alone can match nothing).
    match /{coll}/{docId}/{sub}/{rest=**} {
      allow read, write: if isOwner() || (isPartner() && !adminOnly(coll, docId));
    }

    // Investors can read documents where their email is listed
    match /documents/{docId} {
      allow read: if request.auth != null &&
                     request.auth.token.email in resource.data.allowedEmails;
    }

    // Anyone authenticated can read config (stage info)
    match /config/{docId} {
      allow read: if request.auth != null;
    }

    // Public — only contains SHA-256 hashes of allowed emails (no plaintext),
    // used by the login page to check registration without exposing the list.
    match /config/allowedEmailHashes {
      allow read: if true;
    }

    // Investors can write their own activity log entries — but only the real
    // event types the portal emits. This stops arbitrary values (e.g. HTML
    // payloads) being stored in `type`, which the admin log renders.
    match /activityLog/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.type in ['login', 'logout', 'portal_visit', 'doc_downloaded'];
    }

    // Anyone authenticated can read investor messages
    match /portalMessages/{docId} {
      allow read: if request.auth != null;
    }

    // ════════════════════════════════════════════════════════════════════
    // Team access (Phase 1 — "Portal - Team Access & Roles Plan.md").
    // ADDITIVE ONLY: nothing below restricts partners (isAdmin above) or
    // investors; it only grants team members what their permissions allow.
    // Permissions come from the sign-in token's custom claims
    // (request.auth.token.perms), set by the blocking functions and the
    // teamAccess callable — no extra reads per request.
    // ════════════════════════════════════════════════════════════════════
    function perms() { return request.auth != null ? request.auth.token.get('perms', []) : []; }
    function can(p) { return request.auth != null && p in perms(); }
    function canAny(ps) { return request.auth != null && perms().hasAny(ps); }
    function isStaff() { return request.auth != null && perms().size() > 0; }
    function me() { return request.auth.token.email; }
    // The record was created by this person (activities carry createdBy = email).
    function own() { return resource.data.get('createdBy', '') == me(); }
    function createsAsMe() { return request.resource.data.get('createdBy', me()) == me(); }
    // An update that only touches these fields.
    function onlyFields(fs) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fs); }
    // Email sends refresh "last touch" on the record, nothing else.
    // "Last edited by": a team member can only stamp their own email (or leave it as it was).
    function stampOk() {
      return !('updatedBy' in request.resource.data)
        || request.resource.data.updatedBy == me()
        || (resource != null && request.resource.data.updatedBy == resource.data.get('updatedBy', null));
    }
    function touchOnly() { return onlyFields(['lastTouchAt', 'updatedAt', 'nextContactAt', 'nextContactTime', 'nextContactTz', 'hasOverdue']); }
    // ── Search CRM edit split (30 Sep): own vs any company, deal, flags ──
    function changes(fs) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(fs); }
    function dealFields() { return ['stage', 'reasonExcluded', 'dealSource', 'brokerId', 'dealSizeBand', 'projectName', 'askingPrice', 'targetEV', 'targetMultiple',
      'introCallDate', 'teaserDate', 'ndaSentDate', 'ndaSignedDate', 'cimDate', 'nboDate', 'loiSubmittedDate', 'loiSignedDate', 'exclusivityEnd',
      'ddStartDate', 'financingDate', 'closingDate', 'loiTerms', 'dealNotes']; }
    function flagFields() { return ['priority', 'contactable', 'contactableNote', 'targetTierManual', 'doNotContact']; }
    function stampFields() { return ['updatedAt', 'updatedBy', 'updatedByAt']; }
    // Bookkeeping written when an activity is logged or closed (last touch, attempts).
    function activityTouch() { return onlyFields(['lastTouchAt', 'outreachAttempts', 'lastOutreachAt', 'updatedAt', 'nextContactAt', 'nextContactTime', 'nextContactTz', 'hasOverdue']); }
    // Edit any company, or (search.edit) only companies they own.
    function companyEditor(owner) { return can('search.editall') || (can('search.edit') && owner != null && owner == request.auth.token.get('key', '~')); }
    // Activities are never edited or deleted: only closed once (outcome), or
    // marked when their record is deleted (the history is kept).
    function closeOnly() { return resource.data.get('status', '') == 'open' && onlyFields(['status', 'closedNotes', 'closedAt', 'closedBy']); }
    function recordDeletedOnly() { return onlyFields(['recordDeleted', 'recordName', 'recordDeletedAt', 'recordDeletedBy']); }

    // ── Search CRM ──
    match /searchCompanies/{id} {
      allow read: if can('search.view');
      allow create: if canAny(['search.edit', 'search.editall', 'search.import']) && stampOk();
      allow update: if stampOk() && (
        (companyEditor(resource.data.get('owner', null))
          && (!changes(dealFields()) || can('search.deal'))
          && (!changes(flagFields()) || can('search.flags'))
          && (!changes(['owner']) || can('search.editall')))
        || (can('search.activity') && activityTouch())
        || (can('search.deal') && onlyFields(dealFields().concat(stampFields())))
        || (can('search.flags') && onlyFields(flagFields().concat(stampFields())))
        || (can('search.import') && can('search.editall')));
      allow delete: if can('search.delete');
    }
    match /searchActivities/{id} {
      allow read: if can('search.view');
      allow create: if canAny(['search.activity', 'search.deal', 'search.edit', 'search.editall']) && createsAsMe();
      // Never edited or deleted (source of truth): closed once by anyone who
      // logs activities (B4), or marked when the company is deleted.
      allow update: if (can('search.activity') && closeOnly() && request.resource.data.get('closedBy', me()) == me())
        || (can('search.delete') && recordDeletedOnly());
    }
    match /searchPeople/{id} {
      allow read: if can('search.view');
      allow create, update: if canAny(['search.edit', 'search.editall']);
      allow delete: if can('search.delete');
    }
    // A person ↔ company link follows the company: any company (editall) or
    // one the person owns (search.edit) — one read of the company to check.
    match /searchPersonLinks/{id} {
      allow read: if can('search.view');
      allow create, update: if can('search.editall') || (can('search.edit') && companyEditor(get(/databases/$(database)/documents/searchCompanies/$(request.resource.data.companyId)).data.get('owner', null)));
      allow delete: if can('search.delete') || can('search.editall') || (can('search.edit') && companyEditor(get(/databases/$(database)/documents/searchCompanies/$(resource.data.companyId)).data.get('owner', null)));
    }
    match /searchMapLists/{id} {
      allow read: if can('search.view');
      allow write: if can('search.edit');
    }
    match /searchBrokers/{id} {
      allow read: if can('search.view') || can('out.campaigns');
      allow write: if can('search.admin');
    }
    match /searchConfig/{id} {
      allow read: if can('search.view');
      allow write: if can('search.admin');
    }

    // ── Outreach (most writes go through the callables, which check permissions) ──
    match /outreachThreads/{id} {
      allow read: if can('out.view');
      // Classify / assign / close: people who can write emails. Anyone who can see: mark as read.
      allow update: if canAny(['out.send', 'out.draft', 'out.admin']) || (can('out.view') && onlyFields(['unread']));
    }
    match /outreachMessages/{id} { allow read: if can('out.view'); }
    match /outreachCampaigns/{id} { allow read: if can('out.view') || can('search.view'); }
    match /outreachEnrolments/{id} { allow read: if can('out.view') || can('search.view'); }
    match /outreachTasks/{id} { allow read: if can('out.view'); }
    match /outreachUsage/{id} { allow read: if can('out.view'); }
    match /outreachDaily/{id} { allow read: if can('out.view'); }
    match /outreachIssues/{id} { allow read: if can('out.view'); }
    match /outreachRecurring/{id} { allow read: if can('out.view'); }
    match /outreachPeopleSends/{id} { allow read: if can('out.view'); }
    match /outreachTemplates/{id} {
      allow read: if can('out.view') || can('search.view');
      allow write: if can('out.templates');
    }
    // Outreach settings, sending addresses, legal footer: the Admin (catch-all above).
    match /outreachSenders/{id} {
      allow read: if can('out.view') || can('search.view');
    }
    match /outreachSettings/{id} {
      allow read: if isStaff();
    }
    match /outreachCompliance/{id} {
      allow read: if can('out.view');
    }
    match /outreachSuppression/{id} {
      allow read: if can('out.view');
      allow create, update: if canAny(['out.send', 'out.draft', 'out.admin']);
      // delete: the Admin only (catch-all above)
    }
    match /outreachLists/{id} {
      allow read: if can('out.view');
      allow write: if can('out.campaigns');
      match /members/{m} {
        allow read: if can('out.view');
        allow write: if can('out.campaigns');
      }
    }

    // ── Network ──
    match /networkContacts/{id} {
      allow read: if can('net.view') || can('out.campaigns');
      allow create: if (can('net.edit') || can('out.campaigns')) && stampOk(); // list uploads create Network contacts
      allow update: if (can('net.edit') && stampOk()) || (can('net.email') && touchOnly());
      allow delete: if can('net.delete');
    }
    match /networkFirms/{id} {
      allow read: if can('net.view') || can('out.campaigns');
      allow create: if can('net.edit') && stampOk();
      allow update: if (can('net.edit') && stampOk()) || (can('net.email') && touchOnly());
      allow delete: if can('net.delete');
    }
    match /networkActivities/{id} {
      allow read: if can('net.view');
      allow create: if canAny(['net.edit', 'net.email']) && createsAsMe();
      // Never edited or deleted: closed / cancelled once, or marked when the record is deleted.
      allow update: if (can('net.edit') && closeOnly()) || (can('net.delete') && recordDeletedOnly());
    }
    match /networkFirmActivities/{id} {
      allow read: if can('net.view');
      allow create: if canAny(['net.edit', 'net.email']) && createsAsMe();
      // Never edited or deleted: closed / cancelled once, or marked when the record is deleted.
      allow update: if (can('net.edit') && closeOnly()) || (can('net.delete') && recordDeletedOnly());
    }
    match /networkConfig/{id} {
      allow read: if can('net.view') || can('out.campaigns');
      allow write: if can('net.categories');
    }

    // ── Investor CRM ──
    match /crmInvestors/{id} {
      allow read: if can('icrm.view') || can('out.campaigns');
      allow create: if can('icrm.edit') && stampOk();
      allow update: if (can('icrm.edit') && stampOk()) || (can('icrm.email') && touchOnly());
      allow delete: if can('icrm.delete');
    }
    match /crmActivities/{id} {
      allow read: if can('icrm.view');
      allow create: if canAny(['icrm.edit', 'icrm.email']) && createsAsMe();
      // Never edited or deleted: closed / cancelled once, or marked when the investor is deleted.
      allow update: if (can('icrm.edit') && closeOnly()) || (can('icrm.delete') && recordDeletedOnly());
    }
    match /crmConfig/{id} {
      allow read: if can('icrm.view');
      allow write: if can('icrm.edit');
    }

    // ── Investor portal admin ──
    match /investors/{id} {
      allow read: if can('portal.admin') || can('out.campaigns') || can('portal.viewas');
      allow write: if can('portal.admin');
    }
    match /accessGroups/{id} {
      allow read: if can('portal.admin') || can('out.campaigns');
      allow write: if can('portal.admin');
    }
    match /documents/{id} {
      allow read: if can('portal.admin') || can('portal.viewas'); // "View as": the documents an investor sees
      allow write: if can('portal.admin');
    }
    match /portalMessages/{id} {
      allow write: if can('portal.admin');
    }
    match /config/portal {
      allow write: if can('portal.admin');
    }
    match /config/allowedEmailHashes {
      allow write: if can('portal.admin');
    }
    // Team members' login list (hashes only; written by the server).
    match /config/teamEmailHashes {
      allow read: if true;
    }

    // ── Budget, activity log, shared counters ──
    match /budgetItems/{id} {
      allow read: if can('budget.view');
      allow write: if can('budget.edit');
    }
    match /activityLog/{entryId} {
      allow read: if can('log.view');
      allow create: if isStaff() && request.resource.data.email == me();
    }
    match /dailyReadCounters/{day} { allow read, write: if isStaff(); }
    match /dailyWriteCounters/{day} { allow read, write: if isStaff(); }
    // Usage tab: the Admin reads (catch-all above); written only by the server (functions/usage).

    // ── Team & access (written only by the teamAccess callable) ──
    match /team/{email} {
      allow read: if request.auth != null && request.auth.token.email == email; // + the Admin (catch-all)
    }
    match /roles/{id} { allow read: if isStaff(); }
    // Names + short keys for owner / assignee lists (no emails or permissions).
    match /teamDirectory/{key} { allow read: if isStaff(); }
    // accessAudit: the Admin only (catch-all above).
  }
}
